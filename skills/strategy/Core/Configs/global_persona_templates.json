    "feature_extraction_rules": {
        "refresh_rate": {
            "pattern": "(\\d+)\\s?hz",
            "type": "int",
            "group": "gaming_specs"
        },
        "response_time": {
            "pattern": "(?<![A-Z0-9])(\\d+\\.?\\d*)\\s?ms(?![A-Z])",
            "type": "float",
            "group": "gaming_specs"
        },
        "resolution": {
            "pattern": "(4k|uhd|wqhd|fhd|1080p|1440p|5k|8k)",
            "type": "string",
            "group": "general_specs"
        },
        "panel_type": {
            "pattern": "(ips|va|tn|oled|miniled|ads)",
            "type": "string",
            "group": "general_specs"
        },
        "curvature": {
            "pattern": "(\\d+)\\s?r",
            "type": "int",
            "group": "immersion"
        },
        "docking": {
            "pattern": "(docking|dock|stacja dokuj|usb-c\\s?(power|pd|dock)|\\d+w\\s?pd)",
            "type": "bool",
            "group": "productivity"
        },
        "kvm": {
            "pattern": "(kvm)",
            "type": "bool",
            "group": "productivity"
        },
        "webcam": {
            "pattern": "(webcam|kamera|camera)",
            "type": "bool",
            "group": "productivity"
        },
        "speakers": {
            "pattern": "(głośnik|speakers)",
            "type": "bool",
            "group": "general_specs"
        },
        "touch": {
            "pattern": "(dotyk|touch|pcap|infrared)",
            "type": "bool",
            "group": "specialist"
        },
        "interactive_ifp": {
            "pattern": "(interaktywn|ifp|te\\d+|tablica)",
            "type": "bool",
            "group": "education"
        },
        "android_os": {
            "pattern": "(android|iiware|google)",
            "type": "bool",
            "group": "smart_features"
        },
        "cms_signage": {
            "pattern": "(cms|iisignage|menu board|reklama)",
            "type": "bool",
            "group": "signage"
        },
        "operation_time": {
            "pattern": "(16/7|24/7|12/7)",
            "type": "string",
            "group": "signage"
        }
    },
    "scoring_rules": {
        "gaming_premium": {
            "base_score": 0,
            "conditions": [
                {
                    "feature": "refresh_rate",
                    "operator": ">=",
                    "value": 165,
                    "points": 10
                },
                {
                    "feature": "response_time",
                    "operator": "<",
                    "value": 1.0,
                    "points": 5
                },
